// SEO Gets Clone - Prisma Schema
// Google Search Console Analytics Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Authentication & User Management
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  properties    Property[]
  annotations   Annotation[]
  filters       SavedFilter[]
  contentGroups ContentGroup[]
  topicClusters TopicCluster[]
  seoTests      SeoTest[]
  alerts        Alert[]
  alertRules    AlertRule[]
  reports       Report[]
  magicLinks    MagicLink[]
  teamMembers   TeamMember[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// Google Search Console Properties
// ============================================

model Property {
  id              String    @id @default(cuid())
  userId          String
  siteUrl         String
  displayName     String?
  tags            String[]  @default([])
  isFavorite      Boolean   @default(false)
  isHidden        Boolean   @default(false)
  brandedKeywords String[]  @default([])
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyticsData  AnalyticsData[]
  dailySnapshots DailySnapshot[]
  contentGroups  ContentGroup[]
  topicClusters  TopicCluster[]
  annotations    Annotation[]
  seoTests       SeoTest[]
  alerts         Alert[]
  alertRules     AlertRule[]
  teamMembers    TeamMember[]

  @@unique([userId, siteUrl])
  @@index([userId])
  @@index([siteUrl])
}

// ============================================
// Analytics Data (Time-series)
// ============================================

model AnalyticsData {
  id               String   @id @default(cuid())
  propertyId       String
  date             DateTime
  page             String   @db.Text
  query            String   @db.Text
  country          String   @default("all")
  device           String   @default("all") // mobile, desktop, tablet
  searchAppearance String?
  clicks           Int      @default(0)
  impressions      Int      @default(0)
  ctr              Float    @default(0)
  position         Float    @default(0)
  createdAt        DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, date])
  @@index([propertyId, query])
  @@index([propertyId, page])
  @@index([date])
}

// ============================================
// Daily Aggregated Snapshots
// ============================================

model DailySnapshot {
  id               String   @id @default(cuid())
  propertyId       String
  date             DateTime
  totalClicks      Int      @default(0)
  totalImpressions Int      @default(0)
  avgCtr           Float    @default(0)
  avgPosition      Float    @default(0)
  uniqueQueries    Int      @default(0)
  uniquePages      Int      @default(0)
  createdAt        DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, date])
  @@index([propertyId, date])
}

// ============================================
// Content Groups
// ============================================

model ContentGroup {
  id          String   @id @default(cuid())
  userId      String
  propertyId  String
  name        String
  description String?
  color       String   @default("#3b82f6")
  conditions  Json // Array of condition objects
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([propertyId])
}

// ============================================
// Topic Clusters
// ============================================

model TopicCluster {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  name       String
  keywords   String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([propertyId])
}

// ============================================
// Annotations
// ============================================

model Annotation {
  id          String   @id @default(cuid())
  userId      String
  propertyId  String
  date        DateTime
  title       String
  description String?  @db.Text
  type        String   @default("custom") // google_update, custom, site_change
  isShared    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([propertyId, date])
}

// ============================================
// Saved Filters
// ============================================

model SavedFilter {
  id           String   @id @default(cuid())
  userId       String
  name         String
  filterConfig Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================
// SEO Tests
// ============================================

model SeoTest {
  id           String    @id @default(cuid())
  userId       String
  propertyId   String
  name         String
  startDate    DateTime
  endDate      DateTime?
  testPages    String[]  @default([])
  controlPages String[]  @default([])
  testType     String // title_tag, meta_description, content, url_structure, internal_linking
  metrics      Json?
  results      Json?
  status       String    @default("running") // running, completed, cancelled
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([propertyId])
  @@index([status])
}

// ============================================
// Alerts & Notifications
// ============================================

model Alert {
  id          String   @id @default(cuid())
  userId      String
  propertyId  String?
  type        String // rank_drop, rank_gain, traffic_drop, traffic_spike, ctr_drop, error_spike
  severity    String   @default("medium") // low, medium, high
  title       String
  message     String
  threshold   Json? // Alert configuration/thresholds
  triggeredBy Json? // Data that triggered the alert
  isRead      Boolean  @default(false)
  isMuted     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([propertyId])
  @@index([isRead])
  @@index([createdAt])
}

model AlertRule {
  id          String   @id @default(cuid())
  userId      String
  propertyId  String?
  name        String
  type        String // rank_drop, rank_gain, traffic_drop, traffic_spike, ctr_drop, error_spike
  isEnabled   Boolean  @default(true)
  config      Json // Rule configuration (thresholds, conditions, etc.)
  notifyEmail Boolean  @default(true)
  notifyApp   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([propertyId])
  @@index([isEnabled])
}

// ============================================
// Magic Links (Client Portals)
// ============================================

model MagicLink {
  id          String    @id @default(cuid())
  userId      String
  token       String    @unique @default(cuid())
  propertyIds String[]  @default([])
  password    String?
  expiresAt   DateTime?
  viewCount   Int       @default(0)
  maxViews    Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// ============================================
// Team Collaboration
// ============================================

model TeamMember {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  role       String   @default("viewer") // admin, editor, viewer, client
  invitedBy  String
  joinedAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

// ============================================
// Reports & Scheduled Reports
// ============================================

model Report {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String?
  type        String // custom, traffic, keywords, pages, content_groups
  config      Json // Report configuration (metrics, filters, grouping)
  schedule    String    @default("manual") // manual, daily, weekly, monthly
  nextRun     DateTime?
  isEnabled   Boolean   @default(true)
  recipients  String[]  @default([]) // Email addresses for scheduled reports
  format      String    @default("pdf") // pdf, csv, json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([schedule])
  @@index([nextRun])
}
