# Database
DATABASE_URL="postgresql://username:password@localhost:5432/seo_gets_clone?schema=public"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Google Search Console API
# These will be obtained through OAuth flow

# Cron Jobs (for background sync)
CRON_SECRET="your-cron-secret-key-for-vercel"

# Optional: Redis for caching and job queue
REDIS_URL="redis://localhost:6379"

# Optional: Email service
EMAIL_SERVER="smtp://username:password@smtp.example.com:587"
EMAIL_FROM="noreply@yourdomain.com"

# Optional: AWS S3 for exports
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_BUCKET_NAME="your-bucket-name"
AWS_REGION="us-east-1"

# Optional: Monitoring
SENTRY_DSN="your-sentry-dsn"
